#!/usr/bin/env bash
set -euo pipefail

source_root="${HUB_INSTALL_BRANCH_DIR:-/workspaces/dotfiles/main}"
secret_helper="$source_root/scripts/lib/nono-secret-env.sh"
profile_template_path="${HUB_NONO_PROFILE_TEMPLATE_PATH:-/etc/nono/profiles/devspace-opencode-secure.jsonc}"
profile_path="$profile_template_path"
secret_dir="${HUB_NONO_PROVIDER_SECRET_DIR:-/var/run/secrets/nono/providers}"
secret_helper_sudo="${HUB_NONO_SECRET_HELPER_SUDO:-}"
agent_user="${HUB_NONO_AGENT_USER:-}"
provider_runtime_path="${OPENCODE_PROVIDER_RUNTIME_PATH:-$source_root/.config/opencode/provider-runtime.json}"
model_overrides_path="${HUB_OPENCODE_MODEL_OVERRIDES_PATH:-/workspaces/dotfiles/state/hub/etc/model-overrides.json}"
config_content_helper="$source_root/scripts/lib/opencode-config-content.py"
chatgpt_headers_helper="$source_root/scripts/lib/chatgpt-headers.py"
base_opencode_config="$source_root/.config/opencode/opencode.jsonc"
raw_opencode_binary="${OPENCODE_RAW_BINARY:-/usr/local/bin/opencode-raw}"
nono_binary="${HUB_NONO_BINARY:-/usr/local/bin/nono}"
setpriv_binary="${HUB_NONO_SET_PRIV_BINARY:-/usr/bin/setpriv}"
runtime_home="${HUB_NONO_RUNTIME_HOME:-/home/agent}"
runtime_xdg_config_home="${HUB_NONO_RUNTIME_XDG_CONFIG_HOME:-/home/agent/.config}"
runtime_xdg_cache_home="${HUB_NONO_RUNTIME_XDG_CACHE_HOME:-/home/agent/.cache}"
runtime_xdg_data_home="${HUB_NONO_RUNTIME_XDG_DATA_HOME:-/home/agent/.local/share}"
runtime_xdg_state_home="${HUB_NONO_RUNTIME_XDG_STATE_HOME:-/home/agent/.local/state}"
opencode_xdg_state_home="${HUB_OPENCODE_RUNTIME_XDG_STATE_HOME:-/home/agent/.local/state}"
runtime_path="${HUB_NONO_RUNTIME_PATH:-/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin}"
runtime_bash_env="${HUB_NONO_RUNTIME_BASH_ENV:-$source_root/.config/opencode/bash_env.sh}"
generated_profile_writer="${HUB_NONO_GENERATED_PROFILE_WRITER:-/usr/local/libexec/dotfiles-generate-nono-profile}"
generated_profile_dir="${HUB_NONO_GENERATED_PROFILE_DIR:-/etc/nono/profiles/runtime}"
launch_helper="${HUB_NONO_LAUNCH_HELPER:-/usr/local/libexec/dotfiles-launch-opencode-nono}"

agent_uid="$(id -u "$agent_user" 2>/dev/null || true)"
agent_gid="$(id -g "$agent_user" 2>/dev/null || true)"

if [ "${1:-}" = "completion" ]; then
  if [ ! -x "$raw_opencode_binary" ]; then
    printf 'refused: raw opencode binary not executable at %s\n' "$raw_opencode_binary" >&2
    exit 1
  fi
  exec "$raw_opencode_binary" "$@"
fi

if [ ! -r "$secret_helper" ]; then
  printf 'refused: nono secret helper not found at %s\n' "$secret_helper" >&2
  exit 1
fi

if [ ! -r "$profile_template_path" ]; then
  printf 'refused: secure nono profile not found at %s\n' "$profile_template_path" >&2
  exit 1
fi

# shellcheck source=scripts/lib/nono-secret-env.sh
source "$secret_helper"

if [ -z "$secret_helper_sudo" ]; then
  printf 'refused: HUB_NONO_SECRET_HELPER_SUDO must be set to constrained non-interactive sudo invocation\n' >&2
  exit 1
fi

if [ -z "$agent_user" ]; then
  printf 'refused: HUB_NONO_AGENT_USER must be set to non-sudo agent username\n' >&2
  exit 1
fi

if [ -z "$agent_uid" ] || [ -z "$agent_gid" ]; then
  printf 'refused: unable to resolve uid/gid for HUB_NONO_AGENT_USER=%s\n' "$agent_user" >&2
  exit 1
fi

if [ ! -r "$provider_runtime_path" ]; then
  printf 'refused: generated provider runtime output not found at %s\n' "$provider_runtime_path" >&2
  exit 1
fi

# Provider config plus host-local model overrides; refuses before any sudo call.
opencode_config_content="$(python3 "$config_content_helper" --runtime "$provider_runtime_path" --overrides "$model_overrides_path" --agents-dir "$source_root/.config/opencode/agents")" || exit 1

# Values a caller could set to change ChatGPT state; only this script decides them.
unset OPENAI_CHATGPT_SESSION OPENCODE_AUTH_CONTENT OPENCODE_EXPERIMENTAL_WEBSOCKETS

# Secrets for the enabled providers, taken from the payload the helper already validated.
# The ChatGPT session is optional: without it, other providers still launch.
provider_secrets="$({
  python3 -c '
import json
import sys

secret_key_by_provider = {
    "anthropic": "anthropic_api_key",
    "github-copilot": "github_token",
    "gpt-uio-yellow": "gpt_uio_yellow_api_key",
    "gpt-uio-red": "gpt_uio_red_api_key",
}

enabled = json.loads(sys.argv[1])["enabled_providers"]
for provider in enabled:
    key = secret_key_by_provider.get(provider)
    if key:
        print("required", key)
if "openai-chatgpt" in enabled:
    print("optional", "openai_chatgpt_session")
' "$opencode_config_content"
} || exit 1)"

required_secret_key_list=()
optional_secret_key_list=()
while read -r kind key; do
  case "$kind" in
    required) required_secret_key_list+=("$key") ;;
    optional) optional_secret_key_list+=("$key") ;;
  esac
done <<<"$provider_secrets"

if [ "${#required_secret_key_list[@]}" -gt 0 ] || [ "${#optional_secret_key_list[@]}" -gt 0 ]; then
  exports_payload="$(nono_secret_env_emit_exports "$secret_dir" --keys "${required_secret_key_list[@]}" --optional-keys "${optional_secret_key_list[@]}")"
  eval "$exports_payload"
fi

if [ "${#optional_secret_key_list[@]}" -gt 0 ]; then
  chatgpt_session_state="$(python3 -I "$chatgpt_headers_helper" --state)" || chatgpt_session_state='invalid'
  case "$chatgpt_session_state" in
    valid)
      chatgpt_state='connected'
      ;;
    expiring)
      chatgpt_state='connected'
      printf 'warning: the ChatGPT login expires within 24 hours; run devspace run-pipeline login --provider chatgpt on the host\n' >&2
      ;;
    missing)
      chatgpt_state='disconnected'
      printf 'notice: ChatGPT is enabled but not connected; run devspace run-pipeline login --provider chatgpt on the host. Launching without ChatGPT.\n' >&2
      ;;
    *)
      chatgpt_state='disconnected'
      printf 'notice: the ChatGPT login is %s; run devspace run-pipeline login --provider chatgpt on the host. Launching without ChatGPT.\n' "$chatgpt_session_state" >&2
      ;;
  esac
  [ "$chatgpt_state" = connected ] || unset OPENAI_CHATGPT_SESSION

  # The model chosen on the command line, for the explicit-selection check.
  launch_model=''
  previous_arg=''
  for arg in "$@"; do
    case "$previous_arg" in --model|-m) launch_model="$arg" ;; esac
    case "$arg" in --model=*) launch_model="${arg#--model=}" ;; esac
    previous_arg="$arg"
  done

  opencode_config_content="$(python3 "$config_content_helper" --chatgpt-state "$chatgpt_state" --payload "$opencode_config_content" --base-config "$base_opencode_config" --launch-model "$launch_model")" || exit 1
fi

if [ ! -x "$raw_opencode_binary" ]; then
  printf 'refused: raw opencode binary not executable at %s\n' "$raw_opencode_binary" >&2
  exit 1
fi

if [ ! -x "$nono_binary" ]; then
  printf 'refused: nono binary not executable at %s\n' "$nono_binary" >&2
  exit 1
fi

if [ ! -x "$setpriv_binary" ]; then
  printf 'refused: setpriv binary not executable at %s\n' "$setpriv_binary" >&2
  exit 1
fi

if [ ! -x "$generated_profile_writer" ]; then
  printf 'refused: generated nono profile writer not executable at %s\n' "$generated_profile_writer" >&2
  exit 1
fi

if [ ! -x "$launch_helper" ]; then
  printf 'refused: nono launch helper not executable at %s\n' "$launch_helper" >&2
  exit 1
fi

if [ ! -r "$runtime_bash_env" ]; then
  printf 'refused: runtime BASH_ENV helper not readable at %s\n' "$runtime_bash_env" >&2
  exit 1
fi

# Clear inherited nested-sandbox/session markers before launching a new nono runtime.
# If these leak into a fresh launch, diagnostics like `nono why --self` can reload
# stale session state (e.g. tty/fd paths) and fail with path-drift parse errors.
unset NONO_CAP_FILE NONO_TOOL_SANDBOX_SOCKET NONO_TOOL_SANDBOX_SHIM_DIR NONO_PROXY_TOKEN NONO_NO_PROXY

profile_path="$(sudo -n -- "$generated_profile_writer" --template "$profile_template_path" --runtime "$provider_runtime_path" --output-dir "$generated_profile_dir")"

if [ ! -r "$profile_path" ]; then
  printf 'refused: generated nono profile not readable at %s\n' "$profile_path" >&2
  exit 1
fi


exec sudo -n -- "$launch_helper" --setpriv-binary "$setpriv_binary" --nono-binary "$nono_binary" --profile "$profile_path" --agent-uid "$agent_uid" --agent-gid "$agent_gid" --runtime-home "$runtime_home" --runtime-xdg-config-home "$runtime_xdg_config_home" --runtime-xdg-cache-home "$runtime_xdg_cache_home" --runtime-xdg-data-home "$runtime_xdg_data_home" --runtime-xdg-state-home "$runtime_xdg_state_home" --opencode-xdg-state-home "$opencode_xdg_state_home" --runtime-path "$runtime_path" --runtime-bash-env "$runtime_bash_env" --opencode-config-content "$opencode_config_content" --raw-opencode-binary "$raw_opencode_binary" -- "$@"

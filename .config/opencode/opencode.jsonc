{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "maestro",
  "model": "gpt-uio-yellow/Inferact/GLM-5.3-NVFP4",
  // #2 switch when: you need stronger analysis (UiO GPT quota permitting).
  // "model": "gpt-uio-yellow/gpt-6.1-terra",
  // #3 switch when: UiO pools are constrained.
  // "model": "github-copilot/claude-sonnet-5.5",
  "small_model": "gpt-uio-yellow/google/gemma-4-31B-it",
  // #2 switch when: Gemma is unavailable (local).
  // "small_model": "gpt-uio-yellow/Qwen/Qwen3.8-27B-FP8",
  // #3 switch when: both local models above are unavailable (local).
  // "small_model": "gpt-uio-yellow/gpt-oss-120b",
  "plugin": [
    "oc-plugin-karpathy-guidelines@latest",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "permission": {
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "which *": "allow",
      "type *": "allow",
      "echo *": "allow",
      "true": "allow",
      "false": "allow",
      "sort": "allow",
      "cut *": "allow",
      "tee *": "allow",
      "wc *": "allow",
      "test *": "allow",
      "mkdir *": "allow",
      "git log*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git rev-parse*": "allow",
      "git merge-base*": "allow",
      "git worktree list*": "allow",
      "git ls-tree*": "allow",
      "git commit*": "ask",
      "git add*": "ask",
      "git worktree add*": "ask",
      "git reset*": "ask",
      "git revert*": "ask",
      "sed *": "allow",
      "sed -i*": "ask",
      "git push*": "deny",
      "rm *": "deny",
      "ssh*": "deny",
      "scp*": "deny",
      "sftp*": "deny",
      "ftp*": "deny"
    },
    "external_directory": {
      "**": "ask",
      "/workspaces/dotfiles/**": "allow",
      "/home/vscode/.config/opencode/**": "allow",
      "/home/vscode/.local/share/opencode/**": "allow",
      "/home/agent/.config/opencode/**": "allow",
      "/home/agent/.local/share/opencode/**": "allow",
      "/tmp/**": "allow"
    }
  },
  "agent": {
    "build": {
      "model": "github-copilot/claude-sonnet-5.5",
      // #2 switch when: Copilot is constrained or rate-limited.
      // "model": "gpt-uio-yellow/gpt-6.1-sol",
      // #3 switch when: both pools above are unavailable.
      // "model": "github-copilot/gpt-6.2-sol",
      // Escalation for hard tasks (manual): github-copilot/claude-opus-5.5
    },
    "plan": {
      "model": "github-copilot/claude-opus-5.5",
      // #2 switch when: Copilot is constrained or rate-limited.
      // "model": "gpt-uio-yellow/gpt-6.1-sol",
      // #3 switch when: both pools above are unavailable.
      // "model": "github-copilot/gpt-6.2-sol",
    },
    "general": {
      "model": "gpt-uio-yellow/Inferact/GLM-5.3-NVFP4",
      // #2 switch when: you need stronger analysis (UiO GPT quota permitting).
      // "model": "gpt-uio-yellow/gpt-6.1-terra",
      // #3 switch when: UiO pools are constrained.
      // "model": "github-copilot/claude-sonnet-5.5",
    },
    "explore": {
      "model": "gpt-uio-yellow/gpt-6-luna",
      // #2 switch when: the #1 pool is depleted or rate-limited (set via the host-local overrides file).
      // "model": "github-copilot/claude-haiku-5.5",
      // #3 switch when: both pools above are unavailable.
      // "model": "gpt-uio-yellow/gpt-5-mini",
    },
    "title": {
      "model": "gpt-uio-yellow/google/gemma-4-31B-it",
      // #2 switch when: Gemma is unavailable (local).
      // "model": "gpt-uio-yellow/Qwen/Qwen3.8-27B-FP8",
      // #3 switch when: both local models above are unavailable (local).
      // "model": "gpt-uio-yellow/gpt-oss-120b",
    },
    "summary": {
      "model": "gpt-uio-yellow/google/gemma-4-31B-it",
      // #2 switch when: Gemma is unavailable (local).
      // "model": "gpt-uio-yellow/Qwen/Qwen3.8-27B-FP8",
      // #3 switch when: both local models above are unavailable (local).
      // "model": "gpt-uio-yellow/gpt-oss-120b",
    },
    "compaction": {
      "model": "gpt-uio-yellow/Inferact/GLM-5.3-NVFP4",
      // #2 switch when: GLM is unavailable; Mistral has a 256K context (local).
      // "model": "gpt-uio-yellow/mistralai/Mistral-Medium-3.5-128B",
      // #3 switch when: both local models above are unavailable; Qwen has a 262K context (local).
      // "model": "gpt-uio-yellow/Qwen/Qwen3.8-27B-FP8",
    }
  },
  "lsp": true
}

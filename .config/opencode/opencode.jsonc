{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "maestro",
  "model": "gpt-uio-yellow/nvidia/GLM-5.2-NVFP4",
  // #2 switch when: you need stronger all-round quality and UiO quotas are healthy.
  // "model": "gpt-uio-yellow/moonshotai/Kimi-K2.6",
  // #3 switch when: you want highest precision for difficult general tasks and can spend Copilot credits.
  // "model": "github-copilot/gpt-5.4",
  "small_model": "gpt-uio-yellow/google/gemma-4-31B-it",
  // #2 switch when: non-commercial low-stakes utility traffic is high and you want to preserve other UiO pools.
  // "small_model": "gpt-uio-yellow/MiniMaxAI/MiniMax-M3-MXFP8",
  // #3 switch when: you need tighter utility consistency than small open models.
  // "small_model": "gpt-uio-yellow/gpt-5-mini",
  "plugin": [
    "oc-plugin-karpathy-guidelines@latest",
    "superpowers@git+https://github.com/obra/superpowers.git",
    "@bybrawe/opencode-loop"
  ],
  "permission": {
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "which *": "allow",
      "type *": "allow",
      "echo *": "allow",
      "true": "allow",
      "false": "allow",
      "sort": "allow",
      "cut *": "allow",
      "tee *": "allow",
      "wc *": "allow",
      "test *": "allow",
      "mkdir *": "allow",
      "git log*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git rev-parse*": "allow",
      "git merge-base*": "allow",
      "git worktree list*": "allow",
      "git ls-tree*": "allow",
      "git commit*": "ask",
      "git add*": "ask",
      "git worktree add*": "ask",
      "git reset*": "ask",
      "git revert*": "ask",
      "sed *": "allow",
      "sed -i*": "ask",
      "git push*": "deny",
      "rm *": "deny",
      "ssh*": "deny",
      "scp*": "deny",
      "sftp*": "deny",
      "ftp*": "deny"
    },
    "external_directory": {
      "**": "ask",
      "/workspaces/dotfiles/**": "allow",
      "/home/vscode/.config/opencode/**": "allow",
      "/home/vscode/.local/share/opencode/**": "allow",
      "/home/agent/.config/opencode/**": "allow",
      "/home/agent/.local/share/opencode/**": "allow"
    }
  },
  "agent": {
    "build": {
      "model": "gpt-uio-yellow/Qwen/Qwen3.6-27B-FP8",
      // #2 switch when: build workloads are mostly high-volume throughput and cost-sensitive.
      // "model": "gpt-uio-yellow/gpt-oss-120b",
      // #3 switch when: complex coding fixes demand specialist model strength.
      // "model": "github-copilot/gpt-5.3-codex"
    },
    "plan": {
      "model": "gpt-uio-yellow/gpt-5.1",
      // #2 switch when: GPT-5.1 quota/latency is tight.
      // "model": "gpt-uio-yellow/gpt-5.4",
      // #3 switch when: preserving GPT quotas for other roles is more important than peak planning quality.
      // "model": "gpt-uio-yellow/mistralai/Mistral-Medium-3.5-128B"
    },
    "general": {
      "model": "gpt-uio-yellow/moonshotai/Kimi-K2.6",
      // #2 switch when: you need stricter analytical behavior.
      // "model": "gpt-uio-yellow/nvidia/GLM-5.2-NVFP4",
      // #3 switch when: quality-critical answers are needed and UiO quotas are under pressure.
      // "model": "github-copilot/gpt-5.4"
    },
    "explore": {
      "model": "gpt-uio-yellow/moonshotai/Kimi-K2.6",
      // #2 switch when: exploration needs stricter, less chatty synthesis.
      // "model": "gpt-uio-yellow/nvidia/GLM-5.2-NVFP4",
      // #3 switch when: you want fast lower-cost scans.
      // "model": "github-copilot/gpt-5-mini"
    },
    "title": {
      "model": "gpt-uio-yellow/MiniMaxAI/MiniMax-M3-MXFP8",
      // #2 switch when: MiniMax is unavailable.
      // "model": "gpt-uio-yellow/google/gemma-4-31B-it",
      // #3 switch when: you want ultra-consistent short outputs.
      // "model": "gpt-uio-yellow/gpt-5-mini"
    },
    "summary": {
      "model": "gpt-uio-yellow/MiniMaxAI/MiniMax-M3-MXFP8",
      // #2 switch when: MiniMax is unavailable.
      // "model": "gpt-uio-yellow/google/gemma-4-31B-it",
      // #3 switch when: you want tighter summarization consistency.
      // "model": "gpt-uio-yellow/gpt-5-mini"
    },
    "compaction": {
      "model": "gpt-uio-yellow/MiniMaxAI/MiniMax-M3-MXFP8",
      // #2 switch when: MiniMax is unavailable.
      // "model": "gpt-uio-yellow/google/gemma-4-31B-it",
      // #3 switch when: you need tighter compaction quality.
      // "model": "gpt-uio-yellow/gpt-5-mini"
    }
  },
  "lsp": true
}

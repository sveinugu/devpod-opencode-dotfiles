{
  "meta": {
    "name": "devspace-opencode-secure",
    "description": "DevSpace secure OpenCode profile with explicit provider credential routes"
  },
  "groups": {
    "exclude": [
      "dangerous_commands",
      "dangerous_commands_linux"
    ]
  },
  "workdir": {
    "access": "readwrite"
  },
  "filesystem": {
    "read": [
      "/workspaces/dotfiles/**/.zshrc",
      "/workspaces/dotfiles/**/.zprofile",
      "$HOME/.gitconfig",
      "/etc/gitconfig"
    ],
    "allow_file": [
      "/usr/local/bin/opencode-raw"
    ],
    "allow": [
      "$HOME/.opencode",
      "$XDG_CONFIG_HOME/opencode",
      "$XDG_CACHE_HOME/opencode",
      "$XDG_DATA_HOME/opencode",
      "$XDG_DATA_HOME/opentui",
      "$HOME/.local/state/opencode",
      "/workspaces/dotfiles",
      "$HOME/.local/share/direnv",
      "/tmp"
    ],
    "bypass_protection": [
      "/workspaces/dotfiles/**/.zshrc",
      "/workspaces/dotfiles/**/.zprofile"
    ]
  },
  "environment": {
    "allow_vars": [
      "PATH",
      "HOME",
      "TERM",
      "LANG",
      "LC_ALL",
      "USER",
      "SHELL",
      "PWD",
      "XDG_*",
      "HUB_*",
      "OPENCODE_*"
    ],
    "deny_vars": [
      "OPENAI_API_KEY",
      "ANTHROPIC_API_KEY",
      "GITHUB_TOKEN",
      "GPT_UIO_YELLOW_API_KEY",
      "GPT_UIO_RED_API_KEY"
    ]
  },
  "network": {
    "allow_domain": ["*"],
    "credentials": [
      "openai",
      "anthropic",
      "github-copilot",
      "gpt-uio-yellow",
      "gpt-uio-red"
    ],
    "tls_intercept": {
      "ca_env_vars": [
        "SSL_CERT_FILE",
        "REQUESTS_CA_BUNDLE",
        "NODE_EXTRA_CA_CERTS",
        "CURL_CA_BUNDLE",
        "GIT_SSL_CAINFO"
      ]
    },
    "custom_credentials": {
      "openai": {
        "upstream": "https://api.openai.com",
        "credential_key": "env://OPENAI_API_KEY",
        "env_var": "OPENAI_API_KEY",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}"
      },
      "anthropic": {
        "upstream": "https://api.anthropic.com",
        "credential_key": "env://ANTHROPIC_API_KEY",
        "env_var": "ANTHROPIC_API_KEY",
        "inject_header": "x-api-key",
        "credential_format": "{}"
      },
      "github-copilot": {
        "upstream": "https://api.githubcopilot.com",
        "credential_key": "env://GITHUB_TOKEN",
        "env_var": "GITHUB_TOKEN",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}"
      },
      "gpt-uio-yellow": {
        "upstream": "https://gpt.uio.no/api/v1",
        "credential_key": "env://GPT_UIO_YELLOW_API_KEY",
        "env_var": "GPT_UIO_YELLOW_API_KEY",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}"
      },
      "gpt-uio-red": {
        "upstream": "https://gpt.uio.no/api/v1",
        "credential_key": "env://GPT_UIO_RED_API_KEY",
        "env_var": "GPT_UIO_RED_API_KEY",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}"
      }
    }
  },
  "command_policies": {
    "commands": {
      "git": {
        "executable": "/usr/local/bin/git",
        "from": {
          "session": {
            "sandbox": {
              "fs_read": [
                "/workspaces/dotfiles",
                "/usr/local/libexec/git-core",
                "/usr/local/bin",
                "/tmp"
              ],
              "fs_write": [
                "/workspaces/dotfiles"
              ],
              "fs_read_file": [
                "$HOME/.gitconfig",
                "/etc/gitconfig"
              ],
              "exec_paths": [
                "/usr/local/libexec/git-core",
                "/usr/local/bin"
              ]
            }
          }
        }
      },
      "git-receive-pack": {
        "executable": "/usr/local/libexec/git-core/git-receive-pack",
        "from": {
          "session": {
            "sandbox": {
              "fs_read": [
                "/workspaces/dotfiles",
                "/usr/local/libexec/git-core",
                "/usr/local/bin",
                "/tmp"
              ],
              "fs_write": [
                "/workspaces/dotfiles"
              ],
              "fs_read_file": [
                "$HOME/.gitconfig",
                "/etc/gitconfig"
              ],
              "exec_paths": [
                "/usr/local/libexec/git-core",
                "/usr/local/bin"
              ]
            }
          }
        }
      },
      "git-upload-pack": {
        "executable": "/usr/local/libexec/git-core/git-upload-pack",
        "from": {
          "session": {
            "sandbox": {
              "fs_read": [
                "/workspaces/dotfiles",
                "/usr/local/libexec/git-core",
                "/usr/local/bin",
                "/tmp"
              ],
              "fs_write": [
                "/workspaces/dotfiles"
              ],
              "fs_read_file": [
                "$HOME/.gitconfig",
                "/etc/gitconfig"
              ],
              "exec_paths": [
                "/usr/local/libexec/git-core",
                "/usr/local/bin"
              ]
            }
          }
        }
      },
      "git-upload-archive": {
        "executable": "/usr/local/libexec/git-core/git-upload-archive",
        "from": {
          "session": {
            "sandbox": {
              "fs_read": [
                "/workspaces/dotfiles",
                "/usr/local/libexec/git-core",
                "/usr/local/bin",
                "/tmp"
              ],
              "fs_write": [
                "/workspaces/dotfiles"
              ],
              "fs_read_file": [
                "$HOME/.gitconfig",
                "/etc/gitconfig"
              ],
              "exec_paths": [
                "/usr/local/libexec/git-core",
                "/usr/local/bin"
              ]
            }
          }
        }
      }
    }
  }
}

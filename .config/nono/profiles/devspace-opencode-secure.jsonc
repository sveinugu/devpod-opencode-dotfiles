{
  "extends": "opencode",
  "meta": {
    "name": "devspace-opencode-secure",
    "description": "DevSpace secure OpenCode profile with explicit provider credential routes"
  },
  "groups": {
    "exclude": [
      "dangerous_commands",
      "dangerous_commands_linux"
    ]
  },
  "filesystem": {
    "allow": [
      "$HOME/.cache",
      "$HOME/.npm",
      "$HOME/.local/share/direnv",
      "$HOME/.prefect",
      "/workspaces/dotfiles",
      "/tmp"
    ],
    "read": [
      "/etc/debian_version",
      "/etc/gitconfig",
      "/etc/host.conf",
      "/etc/hosts",
      "/etc/mime.types",
      "/etc/nsswitch.conf",
      "/etc/resolv.conf",
      "/usr/local/share/git-core",
      "/usr/local/libexec/git-core"
    ],
    "allow_file": [
      "/usr/local/bin/opencode-raw",
      "/usr/local/bin/git",
      "/usr/local/bin/git-receive-pack",
      "/usr/local/bin/git-upload-pack",
      "/usr/local/bin/git-upload-archive"
    ],
    "read_file": [],
    "bypass_protection": [
      "/workspaces/dotfiles/**/.zshrc",
      "/workspaces/dotfiles/**/.zprofile"
    ]
  },
  "environment": {
    "allow_vars": [
      "PATH",
      "HOME",
      "TERM",
      "LANG",
      "LC_ALL",
      "USER",
      "SHELL",
      "PWD",
      "XDG_*",
      "HUB_*",
      "OPENCODE_*"
    ],
    "deny_vars": [
      "OPENAI_API_KEY",
      "ANTHROPIC_API_KEY",
      "GITHUB_TOKEN",
      "GPT_UIO_YELLOW_API_KEY",
      "GPT_UIO_RED_API_KEY"
    ]
  },
  "network": {
    "no_proxy": ["localhost", "127.0.0.1"],
    "open_port_range": [
      [1, 65535]
    ],
    "credentials": [
      "openai",
      "anthropic",
      "github-copilot",
      "gpt-uio-yellow",
      "gpt-uio-red"
    ],
    "tls_intercept": {
      "ca_env_vars": [
        "SSL_CERT_FILE",
        "REQUESTS_CA_BUNDLE",
        "NODE_EXTRA_CA_CERTS",
        "CURL_CA_BUNDLE",
        "GIT_SSL_CAINFO"
      ]
    },
    "custom_credentials": {
      "openai": {
        "upstream": "https://api.openai.com",
        "credential_key": "env://OPENAI_API_KEY",
        "env_var": "OPENAI_API_KEY",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}"
      },
      "anthropic": {
        "upstream": "https://api.anthropic.com",
        "credential_key": "env://ANTHROPIC_API_KEY",
        "env_var": "ANTHROPIC_API_KEY",
        "inject_header": "x-api-key",
        "credential_format": "{}"
      },
      "github-copilot": {
        "upstream": "https://api.githubcopilot.com",
        "credential_key": "env://GITHUB_TOKEN",
        "env_var": "GITHUB_TOKEN",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}"
      },
      "gpt-uio-yellow": {
        "upstream": "https://gpt.uio.no/api/v1",
        "credential_key": "env://GPT_UIO_YELLOW_API_KEY",
        "env_var": "GPT_UIO_YELLOW_API_KEY",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}"
      },
      "gpt-uio-red": {
        "upstream": "https://gpt.uio.no/api/v1",
        "credential_key": "env://GPT_UIO_RED_API_KEY",
        "env_var": "GPT_UIO_RED_API_KEY",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}"
      }
    },
    "rate_limit": {
      "requests_per_minute": 0
    }
  },
  "open_urls": {
    "allow_origins": [
      "http://127.0.0.1"
    ],
    "allow_localhost": true
  }
}

{
  "meta": {
    "name": "devspace-opencode-secure",
    "description": "DevSpace secure OpenCode profile with explicit provider credential routes"
  },
  "groups": {
    "include": [
      "node_runtime",
      "rust_runtime",
      "python_runtime",
      { "name": "user_caches_macos", "when": "macos" },
      { "name": "user_caches_linux", "when": "linux" },
      { "name": "linux_sysfs_read", "when": "linux" },
      "nix_runtime",
      "git_config",
      "unlink_protection",
      { "name": "opencode_linux", "when": "linux" }
    ],
    "exclude": [
      "dangerous_commands",
      "dangerous_commands_linux"
    ]
  },
  "workdir": {
    "access": "readwrite"
  },
  "filesystem": {
    "read": [
      "/workspaces/dotfiles/**/.zshrc",
      "/workspaces/dotfiles/**/.zprofile",
      "$HOME/.gitconfig",
      "/etc/gitconfig",
      "/etc/mime.types"
    ],
    "allow_file": [
      "/usr/local/bin/opencode-raw",
      "/usr/local/bin/git",
      "/usr/local/bin/git-receive-pack",
      "/usr/local/bin/git-upload-pack",
      "/usr/local/bin/git-upload-archive"
    ],
    "allow": [
      "$HOME/.opencode",
      "$HOME/.cache",
      "$HOME/.agents",
      "$HOME/.npm",
      "$XDG_CONFIG_HOME/opencode",
      "$XDG_CACHE_HOME/opencode",
      "$XDG_DATA_HOME/opencode",
      "$XDG_DATA_HOME/opentui",
      "/usr/local/share/git-core",
      "/usr/local/libexec/git-core",
      "$HOME/.local/state/opencode",
      "/workspaces/dotfiles",
      "$HOME/.local/share/direnv",
      "$HOME/.prefect",
      "/tmp"
    ],
    "bypass_protection": [
      "/workspaces/dotfiles/**/.zshrc",
      "/workspaces/dotfiles/**/.zprofile"
    ]
  },
  "environment": {
    "allow_vars": [
      "PATH",
      "HOME",
      "TERM",
      "LANG",
      "LC_ALL",
      "USER",
      "SHELL",
      "PWD",
      "XDG_*",
      "HUB_*",
      "DYN_*",
      "TMPDIR",
      "TMP",
      "TEMP",
      "OPENCODE_*"
    ],
    "deny_vars": [
      "OPENAI_API_KEY",
      "ANTHROPIC_API_KEY",
      "GITHUB_TOKEN",
      "GPT_UIO_YELLOW_API_KEY",
      "GPT_UIO_RED_API_KEY"
    ]
  },
  "network": {
    "allow_domain": ["*"],
    "credentials": [
      "openai",
      "anthropic",
      "github-copilot",
      "gpt-uio-yellow",
      "gpt-uio-red"
    ],
    "open_port": [0],
    "listen_port": [0],
    "open_port_range": [
      [32768, 65535]
    ],
    "listen_port_range": [
      [32768, 65535]
    ],
    "tls_intercept": {
      "ca_env_vars": [
        "SSL_CERT_FILE",
        "REQUESTS_CA_BUNDLE",
        "NODE_EXTRA_CA_CERTS",
        "CURL_CA_BUNDLE",
        "GIT_SSL_CAINFO"
      ]
    },
    "custom_credentials": {
      "openai": {
        "upstream": "https://api.openai.com",
        "credential_key": "env://OPENAI_API_KEY",
        "env_var": "OPENAI_API_KEY",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}"
      },
      "anthropic": {
        "upstream": "https://api.anthropic.com",
        "credential_key": "env://ANTHROPIC_API_KEY",
        "env_var": "ANTHROPIC_API_KEY",
        "inject_header": "x-api-key",
        "credential_format": "{}"
      },
      "github-copilot": {
        "upstream": "https://api.githubcopilot.com",
        "credential_key": "env://GITHUB_TOKEN",
        "env_var": "GITHUB_TOKEN",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}"
      },
      "gpt-uio-yellow": {
        "upstream": "https://gpt.uio.no/api/v1",
        "credential_key": "env://GPT_UIO_YELLOW_API_KEY",
        "env_var": "GPT_UIO_YELLOW_API_KEY",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}"
      },
      "gpt-uio-red": {
        "upstream": "https://gpt.uio.no/api/v1",
        "credential_key": "env://GPT_UIO_RED_API_KEY",
        "env_var": "GPT_UIO_RED_API_KEY",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}"
      }
    }
  }
}

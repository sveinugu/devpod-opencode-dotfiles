{
  "extends": "nolabs-ai/opencode-v1",
  "meta": {
    "name": "devspace-opencode-secure",
    "description": "DevSpace secure OpenCode profile with explicit provider credential routes"
  },
  "groups": {
    "exclude": [
      "dangerous_commands",
      "dangerous_commands_linux"
    ]
  },
  "filesystem": {
    "allow": [
      "$HOME/.cache",
      "$HOME/.npm",
      "$HOME/.local/share/direnv",
      "$HOME/.prefect",
      "/workspaces/dotfiles",
      "/tmp"
    ],
    "read": [
      "/etc/debian_version",
      "/etc/gitconfig",
      "/etc/host.conf",
      "/etc/hosts",
      "/etc/mime.types",
      "/etc/nsswitch.conf",
      "/etc/resolv.conf",
      "/usr/local/share/git-core",
      "/usr/local/libexec/git-core"
    ],
    "allow_file": [
      "/usr/local/bin/opencode-raw",
      "/usr/local/bin/git",
      "/usr/local/bin/git-receive-pack",
      "/usr/local/bin/git-upload-pack",
      "/usr/local/bin/git-upload-archive"
    ],
    "read_file": [],
    "bypass_protection": [
      "/workspaces/dotfiles/**/.zshrc",
      "/workspaces/dotfiles/**/.zprofile"
    ],
    "unix_socket_subtree": [
      "/run/nscd"
    ]
  },
  "environment": {
    "allow_vars": [
      "PATH",
      "HOME",
      "TERM",
      "LANG",
      "LC_ALL",
      "USER",
      "SHELL",
      "PWD",
      "XDG_*",
      "HUB_*",
      "OPENCODE_*"
    ],
    "deny_vars": [
      "OPENAI_API_KEY",
      "OPENAI_CHATGPT_SESSION",
      "ANTHROPIC_API_KEY",
      "GITHUB_TOKEN",
      "GPT_UIO_YELLOW_API_KEY",
      "GPT_UIO_RED_API_KEY"
    ]
  },
  "network": {
    "allow_domain": ["*"],
    "credentials": [
      "openai-chatgpt",
      "anthropic",
      "github-copilot",
      "gpt-uio-yellow",
      "gpt-uio-red"
    ],
    "tls_intercept": {
      "ca_env_vars": [
        "SSL_CERT_FILE",
        "REQUESTS_CA_BUNDLE",
        "NODE_EXTRA_CA_CERTS",
        "CURL_CA_BUNDLE",
        "GIT_SSL_CAINFO"
      ]
    },
    "custom_credentials": {
      "openai-chatgpt": {
        "upstream": "https://chatgpt.com/backend-api/codex",
        "credential_key": "cmd://openai_chatgpt",
        "env_var": "OPENAI_CHATGPT_ROUTE_TOKEN"
      },
      "anthropic": {
        "upstream": "https://api.anthropic.com",
        "credential_key": "env://ANTHROPIC_API_KEY",
        "env_var": "ANTHROPIC_API_KEY",
        "inject_header": "x-api-key",
        "credential_format": "{}"
      },
      "github-copilot": {
        "upstream": "https://api.githubcopilot.com",
        "credential_key": "env://GITHUB_TOKEN",
        "env_var": "GITHUB_TOKEN",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}"
      },
      "gpt-uio-yellow": {
        "upstream": "https://gpt.uio.no/api/v1",
        "credential_key": "env://GPT_UIO_YELLOW_API_KEY",
        "env_var": "GPT_UIO_YELLOW_API_KEY",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}"
      },
      "gpt-uio-red": {
        "upstream": "https://gpt.uio.no/api/v1",
        "credential_key": "env://GPT_UIO_RED_API_KEY",
        "env_var": "GPT_UIO_RED_API_KEY",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}"
      }
    }
  },
  "linux": {
    "isolate": {
      "network": true,
      "loopback": true
    }
  },
  "credential_capture": {
    "openai_chatgpt": {
      "command": ["/usr/local/libexec/dotfiles-chatgpt-headers"],
      "timeout_secs": 5,
      "cache_ttl_secs": 0,
      "output": {
        "format": "json",
        "allow_headers": ["Authorization", "ChatGPT-Account-Id", "x-openai-internal-codex-residency"]
      }
    }
  }
}

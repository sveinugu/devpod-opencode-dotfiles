#!/usr/bin/env bash
set -euo pipefail

# Store a provider credential in the workspace's provider Secret, from the host.
# See docs/superpowers/specs/2026-11-19-openai-chatgpt-plan-support-design.md.
#
# chatgpt and copilot: OpenCode's login runs in the workspace pod, outside nono,
# in a temporary directory. uio-yellow and uio-red: the API key is read here,
# without echo. Every value is checked before it is stored, and reaches the
# Secret only through standard input of one kubectl patch that changes only
# the provider's key.

usage() {
  cat <<'USAGE'
usage: provider-login <provider> [--reset]

  chatgpt      log in with a ChatGPT Plus/Pro plan (stored as openai_chatgpt_session)
  copilot      log in with GitHub Copilot on GitHub.com (stored as github_token)
  uio-yellow   enter a UiO yellow API key (stored as gpt_uio_yellow_api_key)
  uio-red      enter a UiO red API key (stored as gpt_uio_red_api_key)
  --reset      remove the stored value (does not revoke it at the provider)

Run it through devspace, which sets DEVSPACE_NAMESPACE:
  devspace run-pipeline login --provider <provider> [--reset]

Environment: DEVSPACE_NAMESPACE (required), KUBECTL_BIN, HUB_WORKSPACE_DEPLOYMENT.
USAGE
}

provider="${1:-}"
mode="${2:-login}"
case "$provider:$mode:$#" in
  -h:*|--help:*) usage; exit 0 ;;
  *:login:1|*:--reset:2) ;;
  *) usage >&2; exit 2 ;;
esac

# provider -> Secret key, display name
case "$provider" in
  chatgpt)    secret_key='openai_chatgpt_session'; label='ChatGPT' ;;
  copilot)    secret_key='github_token';           label='GitHub Copilot' ;;
  uio-yellow) secret_key='gpt_uio_yellow_api_key'; label='UiO yellow' ;;
  uio-red)    secret_key='gpt_uio_red_api_key';    label='UiO red' ;;
  *) usage >&2; exit 2 ;;
esac

kubectl_bin="${KUBECTL_BIN:-kubectl}"
# devspace exports the namespace it uses (-n in DEVSPACE_FLAGS) to pipelines.
namespace="${DEVSPACE_NAMESPACE:-}"
if [ -z "$namespace" ]; then
  printf 'refused: DEVSPACE_NAMESPACE is not set; run devspace run-pipeline login --provider %s\n' "$provider" >&2
  exit 2
fi
deployment="${HUB_WORKSPACE_DEPLOYMENT:-dotfiles-workspace}"
container='workspace'
secret_name='dotfiles-nono-provider-credentials'
install_env="${HUB_PROVIDER_LOGIN_INSTALL_ENV:-/workspaces/dotfiles/state/hub/etc/install.env}"
copilot_check_url="${HUB_PROVIDER_LOGIN_COPILOT_CHECK_URL:-https://api.githubcopilot.com/models}"
uio_check_url="${HUB_PROVIDER_LOGIN_UIO_CHECK_URL:-https://gpt.uio.no/api/v1/models}"

pod_exec() {
  "$kubectl_bin" exec -n "$namespace" "deploy/$deployment" -c "$container" "$@"
}

# The pod-side steps come from the pod's install branch, the same checkout the
# secure wrapper loads its helpers from. Only main or a work/ checkout is accepted.
resolve_remote() {
  local branch_dir
  # A missing install.env means main; a failed exec (wrong namespace or deployment) is an error.
  branch_dir="$(pod_exec -- sh -c '[ ! -f "$2" ] || sed -n "$1" "$2"' sh \
    's/^\(export[[:space:]]\{1,\}\)\{0,1\}HUB_INSTALL_BRANCH_DIR=//p' "$install_env" </dev/null)" || {
    printf 'refused: could not read the install branch from deploy/%s in namespace %s\n' "$deployment" "$namespace" >&2
    return 1
  }
  branch_dir="$(printf '%s\n' "$branch_dir" | head -n1)"
  branch_dir="${branch_dir:-/workspaces/dotfiles/main}"
  case "$branch_dir" in
    *..*|*//*|*/) ;;
    /workspaces/dotfiles/main|/workspaces/dotfiles/work/[A-Za-z0-9._-]*)
      case "${branch_dir#/workspaces/dotfiles/}" in
        *[!A-Za-z0-9._/-]*) ;;
        *) printf '%s/scripts/lib/provider-login-remote.sh\n' "$branch_dir"; return 0 ;;
      esac
      ;;
  esac
  printf 'refused: install branch directory in the pod is not main or a work/ checkout\n' >&2
  return 1
}

# The patch document comes on stdin, so no value appears in process arguments.
patch_secret() {
  "$kubectl_bin" patch secret "$secret_name" -n "$namespace" --type merge --patch-file /dev/stdin
}

refuse_unchanged() {
  printf 'refused: %s; the Secret is unchanged\n' "$1" >&2
  exit 1
}

# check_bearer <url> [header...]: GET the URL with the value on stdin as a
# bearer token. The token stays inside python; only the HTTP status is printed.
check_bearer() {
  python3 -I -c '
import sys
import urllib.error
import urllib.request

url, *headers = sys.argv[1:]
request = urllib.request.Request(url, headers={"Authorization": "Bearer " + sys.stdin.read()})
for header in headers:
    name, _, value = header.partition(":")
    request.add_header(name.strip(), value.strip())
try:
    with urllib.request.urlopen(request, timeout=30) as response:
        status = response.status
except urllib.error.HTTPError as error:
    status = error.code
except (urllib.error.URLError, OSError) as error:
    sys.exit(f"could not reach {url}: {error}")
if status != 200:
    sys.exit(f"{url} answered HTTP {status}")
' "$@"
}

if [ "$mode" = --reset ]; then
  printf '{"data":{"%s":null}}' "$secret_key" | patch_secret >/dev/null
  printf '%s credential removed from %s/%s.\n' "$label" "$namespace" "$secret_name"
  if [ "$provider" = chatgpt ]; then
    printf 'Running sessions keep their copy until they stop; stop them now. This does not revoke the login at OpenAI.\n'
  else
    printf 'While %s is enabled, new OpenCode sessions refuse to launch until a new value is stored. Running sessions keep their copy. This does not revoke the credential at the provider.\n' "$label"
  fi
  exit 0
fi

# pod_login: run OpenCode's login in the pod and print the extracted value on stdout.
# remote and login_dir are not local: the EXIT trap needs them after the function returns.
remote=''
login_dir=''
pod_login() {
  local tty_flags=(-i)
  remote="${HUB_PROVIDER_LOGIN_REMOTE:-}"
  if [ -z "$remote" ]; then
    remote="$(resolve_remote)" || exit 1
    printf 'Using the pod checkout %s.\n' "${remote%/scripts/lib/provider-login-remote.sh}" >&2
  fi

  cleanup() {
    if [ -n "$login_dir" ]; then
      pod_exec -- "$remote" cleanup "$login_dir" </dev/null >/dev/null 2>&1 || printf 'warning: could not remove %s in the pod; remove it by hand\n' "$login_dir" >&2
      login_dir=''
    fi
  }
  trap cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  trap 'exit 129' HUP

  login_dir="$(pod_exec -- "$remote" prepare </dev/null)"
  if [ -t 0 ] && [ -t 2 ]; then
    tty_flags=(-i -t)
  fi
  # The login's own output goes to the terminal; only extract writes to stdout.
  pod_exec "${tty_flags[@]}" -- "$remote" login "$provider" "$login_dir" >&2 || refuse_unchanged 'the OpenCode login did not finish'
  pod_exec -- "$remote" extract "$provider" "$login_dir" </dev/null || refuse_unchanged "no usable $label login"
  cleanup
}

# prompt_key: read an API key without echo from the terminal, or from stdin.
prompt_key() {
  local key=''
  if [ -t 0 ]; then
    printf 'Paste the %s API key (input is hidden): ' "$label" >&2
    IFS= read -rs key || true
    printf '\n' >&2
  else
    IFS= read -r key || true
  fi
  key="${key#"${key%%[![:space:]]*}"}"
  key="${key%"${key##*[![:space:]]}"}"
  case "$key" in
    ''|*[[:space:]]*) refuse_unchanged 'the API key is empty or contains spaces' ;;
  esac
  printf '%s' "$key"
}

case "$provider" in
  chatgpt)
    value="$(pod_login)"
    # Check the value again on the host; print only the expiry.
    expiry="$(printf '%s' "$value" | python3 -I -c '
import datetime, json, sys, time
s = json.load(sys.stdin)
ok = (isinstance(s, dict) and set(s) == {"access", "account_id", "expires_at"}
      and all(isinstance(s[k], str) and s[k] for k in ("access", "account_id"))
      and isinstance(s["expires_at"], int) and not isinstance(s["expires_at"], bool)
      and s["expires_at"] > time.time())
if not ok:
    sys.exit(1)
print(datetime.datetime.fromtimestamp(s["expires_at"], datetime.timezone.utc).strftime("%Y-%m-%d %H:%M UTC"))
')" || refuse_unchanged 'the session value is not valid'
    done_message="ChatGPT connected in $namespace/$secret_name. The login expires $expiry; log in again before then."
    ;;
  copilot)
    value="$(pod_login)"
    # Many agent roles use Copilot, so the new token must work before it replaces the old one.
    printf '%s' "$value" | check_bearer "$copilot_check_url" 'Copilot-Integration-Id: vscode-chat' \
      || refuse_unchanged 'the Copilot test call with the new token failed'
    done_message="GitHub Copilot connected in $namespace/$secret_name."
    ;;
  uio-yellow|uio-red)
    value="$(prompt_key)"
    printf '%s' "$value" | check_bearer "$uio_check_url" || refuse_unchanged "the $label API key was not accepted"
    done_message="$label API key stored in $namespace/$secret_name."
    ;;
esac

encoded="$(printf '%s' "$value" | base64 | tr -d '\n')"
unset value
printf '{"data":{"%s":"%s"}}' "$secret_key" "$encoded" | patch_secret >/dev/null
unset encoded

printf '%s\n' "$done_message"
printf 'New sessions use it after the kubelet updates the Secret mount (usually within a minute). Restart running sessions to use it.\n'

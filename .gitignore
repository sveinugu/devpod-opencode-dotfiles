# JetBrains project dir
.idea

# OpenCode dir
.opencode

# Backup files
**/*.bak.*.worktrees

# Env files
**/*.env
**/*.envrc
**/*.envrc.local

# Devspace
.devspace

# Installer-generated harness outputs
.config/opencode/plugins/opencode-loop.ts
.config/opencode/commands/*.md

# External skills are regenerated from top-level skills-lock.json
.agents/skills/*
!.agents/skills/harness-install-maintenance/
!.agents/skills/harness-install-maintenance/SKILL.md

# Nono runtime
.config/nono/packages
.config/nono/profile-drafts
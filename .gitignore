# JetBrains project dir
.idea

# OpenCode dir
.opencode

# Backup files
**/*.bak.*.worktrees

# Env files
**/*.env
**/*.envrc
**/*.envrc.local

# Devspace
.devspace

# Installer-generated harness outputs
.config/opencode/plugins/opencode-loop.js
.config/opencode/plugins/opencode-loop.ts
.config/opencode/commands/*.md
.config/opencode/agents/opencode-loop-local.md

# OpenCode-global skills are fetched during dotfiles installation.
.config/opencode/skills/clean-code/
.config/opencode/skills/pragmatic-programmer/

# External skills are regenerated from top-level skills-lock.json
.agents/skills/*
!.agents/skills/harness-install-maintenance/
!.agents/skills/harness-install-maintenance/SKILL.md

# Nono runtime
.config/nono/packages
.config/nono/profile-drafts
.config/nono/pack-update-hints.json
